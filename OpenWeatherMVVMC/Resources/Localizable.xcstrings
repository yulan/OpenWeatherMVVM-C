    },
    "error.generic.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't load this content. Please try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger ce contenu. Veuillez réessayer."
          }
        }
      }
    },
    "error.generic.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something Went Wrong"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur est survenue"
          }
        }
      }
    },
    "error.locationDenied.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location access in Settings to see the weather where you are."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à votre position dans les Réglages pour voir la météo là où vous êtes."
          }
        }
      }
    },
    "error.locationDenied.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location Access Needed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès à la position requis"
          }
        }
      }
    },
    "error.locationUnavailable.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure Location Services are on, then try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le service de localisation est activé, puis réessayez."
          }
        }
      }
    },
    "error.locationUnavailable.title": {
      "extractionState": "manual",
      "localizations": {
